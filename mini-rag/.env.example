# ==========================================
# Application Configuration
# ==========================================
APP_NAME="mini-rag"
APP_ENV="development"            # development, staging, production
APP_VERSION="1.0.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# ==========================================
# Active Provider Selection
# Controls which backend implementation to load
# ==========================================
LLM_PROVIDER="openai"            # Options: openai, ollama, huggingface, groq
EMBEDDING_PROVIDER="openai"      # Options: openai, huggingface, cohere
VECTOR_DB_PROVIDER="pgvector"    # Options: pgvector, chromadb, qdrant

# ==========================================
# Database Configuration (PostgreSQL / PGVector)
# ==========================================
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="rag_db"
DATABASE_URL="postgresql://user:password@localhost:5432/rag_db"

# ==========================================
# OpenAI Provider Settings
# ==========================================
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ==========================================
# Ollama / Local LLM Settings
# ==========================================
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# ==========================================
# HuggingFace / Local Embeddings Settings
# ==========================================
HUGGINGFACE_API_TOKEN="your-huggingface-token-here"
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# ==========================================
# Vector Database Specifics
# ==========================================
CHROMADB_PERSIST_DIR="./chroma_db"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# ==========================================
# Background Tasks (Celery & Redis)
# ==========================================
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
