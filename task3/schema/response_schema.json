{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "recommendation": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string" },
          "section": { "type": "string" },
          "page": { "type": "number" }
        },
        "required": ["document", "section", "page"]
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "insufficient"]
    }
  },
  "required": ["recommendation", "evidence", "citations", "confidence"],
  "if": {
    "properties": {
      "confidence": {
        "not": {
          "const": "insufficient"
        }
      }
    }
  },
  "then": {
    "properties": {
      "evidence": {
        "minLength": 1
      },
      "citations": {
        "minItems": 1
      }
    }
  }
}